# Copy to .env and adjust. Never commit .env.

# Where runtime state (SQLite database) is stored.
BIZOPS_DATA_DIR=var

# Tenant used when a request does not name one.
BIZOPS_DEFAULT_TENANT=demo

# Model provider: scripted (offline, deterministic), anthropic, or openai.
BIZOPS_LLM_PROVIDER=scripted
BIZOPS_LLM_MODEL=
# Set only when using a hosted provider. Leave empty for the offline demo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Limits applied to every run.
BIZOPS_MAX_STEPS=20
BIZOPS_MAX_REPLANS=2
# Seconds a worker may hold a run without renewing before another worker may take it over.
BIZOPS_RUN_LEASE_SECONDS=60
BIZOPS_MAX_RUN_COST_USD=1.00
BIZOPS_CONTEXT_TOKEN_BUDGET=6000

# Reliability. Time limits in seconds.
BIZOPS_STEP_TIMEOUT_SECONDS=120
BIZOPS_TOOL_TIMEOUT_SECONDS=30
BIZOPS_RETRY_BASE_SECONDS=0.5
BIZOPS_RETRY_MAX_SECONDS=8
# An approval request nobody answers within this time is treated as rejected.
BIZOPS_APPROVAL_TTL_SECONDS=86400

# Hosted model behaviour.
BIZOPS_LLM_TIMEOUT_SECONDS=60
BIZOPS_LLM_MAX_RETRIES=4
# Prices of the selected model in USD per million tokens, from the provider's price list.
# Leave empty and cost is a rough estimate.
BIZOPS_LLM_PRICE_INPUT_PER_MTOK=
BIZOPS_LLM_PRICE_OUTPUT_PER_MTOK=

# Load fictional demo records and policy documents at start-up.
BIZOPS_SEED_DEMO_DATA=true

# HTTP API access. Prefer `bizops keys create NAME --role ROLE`, which issues keys bound to
# one tenant and one role. BIZOPS_API_KEY is an optional bootstrap administrator key for the
# default tenant. With no key of any kind, the API answers only this machine.
BIZOPS_API_KEY=
# Webhook signing secret for the default tenant. Empty disables webhooks.
BIZOPS_WEBHOOK_SECRET=
# Optional: more webhook senders, each bound to a tenant, as JSON keyed by source name:
# {"shop": {"tenant": "acme", "secret": "a-long-random-value"}}
BIZOPS_WEBHOOK_SECRETS=

# Logging: json or text.
BIZOPS_LOG_FORMAT=text
BIZOPS_LOG_LEVEL=INFO
